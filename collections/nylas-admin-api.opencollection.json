{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nylas API (v3) Admin API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
