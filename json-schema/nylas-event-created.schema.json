{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/nylas/refs/heads/main/json-schema/nylas-event-created.schema.json",
  "title": "Nylas event.created notification object",
  "description": "Sent when an event is created on a user's calendar. This schema describes `data.object` inside the Nylas notification envelope.",
  "type": "object",
  "required": [
    "calendar_id",
    "id",
    "object",
    "when"
  ],
  "properties": {
    "account_id": {
      "type": "string",
      "description": "Legacy Nylas v2 account identifier (deprecated)."
    },
    "busy": {
      "type": "boolean",
      "description": "Whether the event marks the user as busy. May be `null` if not set by the provider.",
      "nullable": true
    },
    "calendar_id": {
      "type": "string",
      "description": "Identifier for the calendar this event belongs to. May be `null` in rare edge cases.",
      "nullable": true
    },
    "conferencing": {
      "type": "object",
      "description": "Video conferencing details attached to the event.",
      "properties": {
        "details": {
          "type": "object",
          "description": "Provider-specific conferencing details.",
          "properties": {
            "meeting_code": {
              "type": "string",
              "description": "Meeting code for dial-in access."
            },
            "phone": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Phone numbers for dial-in access."
            },
            "pin": {
              "type": "string",
              "description": "PIN for dial-in access."
            },
            "url": {
              "type": "string",
              "description": "URL to join the meeting."
            }
          }
        },
        "provider": {
          "type": "string",
          "description": "Conferencing provider name (e.g. Google Meet, Zoom)."
        }
      }
    },
    "created_at": {
      "type": "integer",
      "description": "Unix timestamp when the event was created."
    },
    "creator": {
      "type": "object",
      "description": "The user who created the event.",
      "properties": {
        "email": {
          "type": "string",
          "description": "Creator's email address."
        },
        "name": {
          "type": "string",
          "description": "Creator's display name."
        }
      }
    },
    "description": {
      "type": "string",
      "description": "Event description, may contain HTML."
    },
    "grant_id": {
      "type": "string",
      "description": "Unique identifier for the grant that owns this event."
    },
    "hide_participants": {
      "type": "boolean",
      "description": "Whether the participant list is hidden from attendees."
    },
    "html_link": {
      "type": "string",
      "description": "URL to view the event in the provider's web interface."
    },
    "ical_uid": {
      "type": "string",
      "description": "Unique iCalendar identifier for the event."
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for the event."
    },
    "location": {
      "type": "string",
      "description": "Location of the event."
    },
    "metadata": {
      "type": "object",
      "description": "Key-value pairs of custom metadata attached to the event. Events that Nylas Scheduler creates include Scheduler-stamped entries: `source` (always `scheduler`), `key5` (the Scheduler Configuration ID), and `scheduler_last_start`, `scheduler_last_end`, and `scheduler_updated_at` (Unix timestamps, as strings, that record the meeting time Scheduler most recently set).",
      "additionalProperties": {
        "type": "string"
      }
    },
    "object": {
      "type": "string",
      "description": "Object type identifier.",
      "enum": [
        "event"
      ]
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Event IDs of modified occurrences in a recurring series (Google only). Omitted when not applicable."
    },
    "organizer": {
      "type": "object",
      "description": "The organizer of the event.",
      "properties": {
        "email": {
          "type": "string",
          "description": "Organizer's email address."
        },
        "name": {
          "type": "string",
          "description": "Organizer's display name."
        }
      }
    },
    "participants": {
      "type": "array",
      "description": "List of event participants.",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Participant's email address."
          },
          "name": {
            "type": "string",
            "description": "Participant's display name."
          },
          "status": {
            "type": "string",
            "description": "RSVP status of the participant.",
            "enum": [
              "yes",
              "no",
              "maybe",
              "noreply"
            ]
          }
        }
      }
    },
    "read_only": {
      "type": "boolean",
      "description": "Whether the event is read-only for the authenticated user."
    },
    "recurrence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "RRULE strings defining the recurrence pattern."
    },
    "reminders": {
      "type": "object",
      "description": "Reminder settings for the event.",
      "properties": {
        "overrides": {
          "type": "array",
          "description": "Custom reminder overrides.",
          "items": {
            "type": "object"
          }
        },
        "use_default": {
          "type": "boolean",
          "description": "Whether to use the calendar's default reminders."
        }
      }
    },
    "resources": {
      "type": "array",
      "description": "Resources (rooms, equipment) booked for the event.",
      "items": {
        "type": "object"
      }
    },
    "sequence": {
      "type": "integer",
      "description": "iCalendar sequence number, incremented on updates."
    },
    "status": {
      "type": "string",
      "description": "Confirmation status of the event.",
      "enum": [
        "confirmed",
        "tentative",
        "cancelled"
      ]
    },
    "title": {
      "type": "string",
      "description": "Title of the event."
    },
    "updated_at": {
      "type": "integer",
      "description": "Unix timestamp when the event was last updated."
    },
    "visibility": {
      "type": "string",
      "description": "Visibility of the event.",
      "enum": [
        "default",
        "public",
        "private",
        "confidential"
      ]
    },
    "when": {
      "type": "object",
      "description": "Time details for the event. The fields present depend on the `object` subtype: `timespan` has `start_time`/`end_time`/`start_timezone`/`end_timezone`; `datespan` has `start_date`/`end_date`; `date` has `date`; `time` has `time`/`timezone`.",
      "properties": {
        "object": {
          "type": "string",
          "description": "Time object type.",
          "enum": [
            "timespan",
            "datespan",
            "date",
            "time"
          ]
        },
        "start_time": {
          "type": "integer",
          "description": "Unix timestamp when the event starts. Present for `timespan`."
        },
        "end_time": {
          "type": "integer",
          "description": "Unix timestamp when the event ends. Present for `timespan`."
        },
        "start_timezone": {
          "type": "string",
          "description": "IANA timezone for the start time. Present for `timespan`."
        },
        "end_timezone": {
          "type": "string",
          "description": "IANA timezone for the end time. Present for `timespan`."
        },
        "start_date": {
          "type": "string",
          "description": "Start date in `YYYY-MM-DD` format. Present for `datespan`."
        },
        "end_date": {
          "type": "string",
          "description": "End date in `YYYY-MM-DD` format. Present for `datespan`."
        },
        "date": {
          "type": "string",
          "description": "Date in `YYYY-MM-DD` format. Present for `date`."
        },
        "time": {
          "type": "integer",
          "description": "Unix timestamp for a point-in-time event. Present for `time`."
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone. Present for `time`."
        }
      }
    }
  },
  "x-nylas-trigger": "event.created",
  "x-nylas-category": "Events",
  "x-provenance": {
    "method": "authored",
    "publisher": "Nylas",
    "source": "https://developer.nylas.com/docs/reference/notifications/events/event-created/",
    "derived_from": "nylas/developer.nylas.com@a7995fb6:src/_component-data/notification-schemas.json",
    "generated": "2026-09-28"
  },
  "examples": [
    {
      "account_id": "<NYLAS_V2_ACCOUNT_ID>",
      "busy": true,
      "calendar_id": "<CALENDAR_ID>",
      "conferencing": {
        "details": {
          "meeting_code": "<MEETING_CODE>",
          "phone": [
            "<MEETING_PHONE_NUMBER>"
          ],
          "pin": "<MEETING_PIN>",
          "url": "<MEETING_URL>"
        },
        "provider": "<PROVIDER>"
      },
      "created_at": 1545355476,
      "creator": {
        "email": "leyah@example.com",
        "name": "Leyah Miller"
      },
      "description": "<p>Weekly one-on-one.</p>",
      "grant_id": "<NYLAS_GRANT_ID>",
      "hide_participants": true,
      "html_link": "<EVENT_LINK>",
      "ical_uid": "<ICAL_UID>",
      "id": "<EVENT_ID>",
      "location": "Room 103",
      "metadata": {
        "key1": "all-meetings",
        "key2": "on-site"
      },
      "object": "event",
      "organizer": {
        "email": "leyah@example.com",
        "name": "Leyah Miller"
      },
      "participants": [
        {
          "email": "nyla@example.com",
          "status": "yes"
        }
      ],
      "read_only": true,
      "recurrence": [
        "RRULE:FREQ=WEEKLY;WKST=SU;UNTIL=20230420T065959Z;INTERVAL=2"
      ],
      "reminders": {
        "overrides": [],
        "use_default": true
      },
      "resources": [],
      "sequence": 17,
      "status": "confirmed",
      "title": "One-on-one",
      "updated_at": 1724359724,
      "visibility": "default",
      "when": {
        "end_time": 1680800100,
        "end_timezone": "America/Los_Angeles",
        "object": "timespan",
        "start_time": 1680796800,
        "start_timezone": "America/Los_Angeles"
      }
    }
  ]
}